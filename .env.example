# Copy this file to `.env` and edit the values, then run `docker compose up -d`.

# Absolute path to your music library on the host (mounted read-only).
MUSIC_PATH=/path/to/your/music

# Host port to expose the web UI on.
PORT=4534

# Initial admin user. Created on first boot only; ignored once an admin exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# PostgreSQL password. Used by both the app and the db service — keep them in sync.
POSTGRES_PASSWORD=changeme

# MusicBrainz metadata enrichment. MUSICBRAINZ_USER_AGENT is REQUIRED when enabled
# (MusicBrainz rejects generic user agents). Format: <app>/<version> ( <contact> )
MUSICBRAINZ_ENABLED=false
# MUSICBRAINZ_USER_AGENT=amaterasu-player/1.0 ( mailto:you@example.com )
