  "query": "\n            UPDATE tag_categories\n            SET\n                name  = COALESCE($3, name),\n                color = COALESCE($4, color)\n            WHERE\n                id = $1\n                AND user_id = $2\n            RETURNING\n                id,\n                user_id,\n                name,\n                color,\n                position,\n                created_at,\n                updated_at\n            ",
