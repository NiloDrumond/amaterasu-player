DATABASE_URL=postgres://login:password@localhost:5432/amaterasu
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
LOG_DIR=./logs
DATA_DIR=./data
# Optional: push structured logs to a self-hosted Loki instance (see infra/docker-compose.yml).
# Leave unset/blank to disable.
# LOKI_URL=http://localhost:3100
# Optional: Grafana base URL for the reverse-proxy mounted at /admin/logs.
# Leave unset/blank to disable the proxy (returns 503).
# GRAFANA_URL=http://localhost:3001

# Set both to populate the initial admin user on first boot. Skipped if any
# admin already exists. ADMIN_NAME is optional (defaults to "Admin").
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme
# ADMIN_NAME=Admin
