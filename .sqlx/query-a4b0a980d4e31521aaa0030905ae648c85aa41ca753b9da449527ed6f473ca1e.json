{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                c.id,\n                c.user_id,\n                c.name,\n                c.color,\n                c.position,\n                c.created_at,\n                c.updated_at,\n                COUNT(t.id) AS \"tag_count!: i64\"\n            FROM\n                tag_categories c\n            LEFT JOIN tags t ON t.category_id = c.id\n            WHERE\n                c.id = $1\n                AND c.user_id = $2\n            GROUP BY\n                c.id\n            ",
