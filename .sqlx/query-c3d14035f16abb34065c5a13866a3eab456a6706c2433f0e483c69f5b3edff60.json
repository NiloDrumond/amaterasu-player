  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, entity_type, entity_id, source, mbid, score, rank,\n                   proposed, raw, status, created_at, updated_at\n            FROM metadata_suggestions\n            WHERE entity_type = $1\n              AND entity_id = ANY($2)\n              AND status = 'pending'\n            ORDER BY entity_id, rank ASC\n            ",
