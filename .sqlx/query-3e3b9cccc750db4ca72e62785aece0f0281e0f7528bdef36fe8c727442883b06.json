  "db_name": "PostgreSQL",
  "query": "\n            SELECT *\n            FROM artists ar\n            WHERE ar.approved = FALSE\n              AND NOT EXISTS (\n                  SELECT 1 FROM albums al\n                  WHERE al.id = ANY($1)\n                    AND al.artist_id = ar.id\n              )\n            ORDER BY ar.created_at DESC\n            LIMIT $2\n            ",
